{
  "name": "webar-sticker-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "WebAR sticker filter prototype with MindAR, React, Express, SVG stickers, canvas, and QR",
  "scripts": {
    "start": "node server/index.js",
    "dev": "NODE_ENV=development node server/index.js",
    "build": "esbuild public/app.js --bundle --outfile=public/app.bundle.js --format=iife --platform=browser --loader:.js=jsx --minify"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/core-mt": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@supabase/supabase-js": "^2.58.0",
    "axios": "^1.12.2",
    "dotenv": "^17.2.2",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "mp4box": "^2.1.1",
    "multer": "^1.4.5-lts.1"
  }
}
